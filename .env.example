# API base URL — do not change unless the challenge endpoint moves
VITE_PENTATHLON_API_BASE_URL=https://codetest-api.applivery.io

# API key id returned by POST /api-keys/.
# Generate once with:
#   curl -X POST https://codetest-api.applivery.io/api-keys/ \
#        -H "Content-Type: application/json" -d '{}'
# Then paste the "id" field below.
# NEVER commit this value to git. Put it in .env.local (gitignored).
VITE_PENTATHLON_API_KEY=
